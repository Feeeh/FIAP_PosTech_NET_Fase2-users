apiVersion: v1
kind: Secret
metadata:
  name: users-api-secret
  namespace: fcg
  labels:
    app: users-api
    app.kubernetes.io/part-of: fcg
type: Opaque
stringData:
  ConnectionStrings__SqlServer: "Server=sqlserver,1433;Database=fcg_users;User Id=sa;Password=TROCAR_SENHA_SQLSERVER;TrustServerCertificate=True;Encrypt=False"
  RabbitMq__Usuario: TROCAR_USUARIO_RABBITMQ
  RabbitMq__Senha: TROCAR_SENHA_RABBITMQ
  Jwt__ChaveSecreta: TROCAR_CHAVE_JWT_COM_PELO_MENOS_32_BYTES
  AdministradorInicial__Nome: TROCAR_NOME_ADMIN
  AdministradorInicial__Email: TROCAR_EMAIL_ADMIN
  AdministradorInicial__Senha: TROCAR_SENHA_ADMIN
