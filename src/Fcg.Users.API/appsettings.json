{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Emissor": "fcg-users-api",
    "Audiencia": "fcg-clientes",
    "MinutosDeValidade": 60
  },
  "Swagger": {
    "Habilitado": false
  },
  "RabbitMq": {
    "NomeDaAplicacao": "users-api",
    "Host": "localhost",
    "Porta": 5672,
    "Exchange": "fcg.events",
    "ExchangeDeMensagensMortas": "fcg.events.dlx"
  }
}
